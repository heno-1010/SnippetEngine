<Window x:Class="SnippetEngine.AddSnippet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnippetEngine"
        mc:Ignorable="d"
        Title="AddSnippet" Height="450" Width="400"
        Background="#101622">
    <Grid>
        <StackPanel Margin="15">
            <TextBlock Text="Add New Snippet" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Title" Margin="0,20,10,3" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBox x:Name="TitleTextBox" Margin="0,5,10,5" Height="35" Background="#1a2333" Foreground="White" BorderThickness="0" FontSize="16" VerticalAlignment="Top"/>

            <TextBlock Text="Description" Margin="0,10,10,3" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBox x:Name="DescriptionTextBox" Margin="0,5,10,5" Height="35" Background="#1a2333" Foreground="White" BorderThickness="0" FontSize="16" VerticalAlignment="Top"/>

            <TextBlock Text="Code" Margin="0,10,10,3" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBox x:Name="CodeTextBox" Margin="0,5,10,5" Height="150" Background="#1a2333" Foreground="White" BorderThickness="0" FontSize="16" VerticalAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>
    </Grid>
</Window>
